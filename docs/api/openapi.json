              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "description": "ErrorCode 스키마의 값을 쓴다."
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "「자세히 보기」에 펼칠 문장. 없으면 null."
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      },
      "Interrupt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interrupt_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction",
              "requirements",
              "review"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "interrupt_id",
          "kind",
          "message"
        ]
      },
      "RunStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "parsing",
              "awaiting_input",
              "analysing",
              "awaiting_requirements",
              "designing",
              "generating",
              "reviewing",
              "awaiting_review",
              "exporting",
              "completed",
              "failed",
              "cancel_requested",
              "cancelled"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "interrupt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Interrupt"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run_id",
          "status",
          "revision"
        ]
      },
      "ExtractionResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "추출 확인 응답. 문장을 고치지 않고 확인 또는 제외만 한다 (ADR-0015). confirmed=false는 중단이며 excluded_blocks를 비워야 한다.",
        "properties": {
          "kind": {
            "type": "string",
            "const": "extraction"
          },
          "confirmed": {
            "type": "boolean"
          },
          "excluded_blocks": {
            "type": "array",
            "default": [],
            "description": "뺄 원문 블록. fail 블록은 모두 들어 있어야 하고 pass 블록은 넣지 못한다. 사유는 review 블록이면 필수다 (어기면 422 INVALID_RESPONSE).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "block_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null
                }
              },
              "required": [
                "block_id"
              ]
            }
          }
        },
        "required": [
          "kind",
          "confirmed"
        ]
      },
      "RequirementsResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "const": "requirements"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "req_id": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "keep",
                    "edit",
                    "split"
                  ]
                },
                "texts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "req_id",
                "action",
                "texts"
              ]
            }
          }
        },
        "required": [
          "kind",
          "answers"
        ]
      },
      "ReviewResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "const": "review"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "revise",
              "hold"
            ]
          },
          "feedback": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "decision",
          "feedback"
        ]
      },
      "ResumeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interrupt_id": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "response": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ExtractionResponse"
              },
              {
                "$ref": "#/components/schemas/RequirementsResponse"
              },
              {
                "$ref": "#/components/schemas/ReviewResponse"
              }
            ]
          }
        },
        "required": [
          "interrupt_id",
          "expected_revision",
          "response"
        ]
      },
      "RunSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "parsing",
              "awaiting_input",
              "analysing",
              "awaiting_requirements",
              "designing",
              "generating",
              "reviewing",
              "awaiting_review",
              "exporting",
              "completed",
              "failed",
              "cancel_requested",
              "cancelled"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "run_id",
          "status",
          "revision",
          "created_at"
        ]
      },
      "RunView": {
        "type": "object",
        "additionalProperties": false,
        "description": "화면 표시용 읽기 모델. 세부 항목 구조는 데이터 계약 확정(ADR-0009) 후 고정한다.",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "section": {
            "type": "string",
            "enum": [
              "extraction",
              "requirements",
              "design",
              "review"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "normalization": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalization"
          }
        },
        "required": [
          "run_id",
          "revision",
          "section",
          "items"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "description": "오류 code 값 (ADR-0009). Error.code는 확장 가능성 때문에 문자열로 받는다. 실행 실패 원인 코드는 RunStatus.error에 담긴다.",
        "enum": [
          "RUN_NOT_FOUND",
          "RUN_REVISION_CONFLICT",
          "INTERRUPT_STALE",
          "EVENT_REPLAY_EXPIRED",
          "ARTIFACT_NOT_READY",
          "ARTIFACT_FORMAT_UNSUPPORTED",
          "UPLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "PACK_UNSUPPORTED",
          "INVALID_RESPONSE",
          "INVALID_REQUEST",
          "LLM_REFUSED",
          "LLM_OUTPUT_INVALID",
          "LLM_UNAVAILABLE",
          "BUDGET_EXCEEDED",
          "EXTRACTION_FAILED",
          "INTERNAL"
        ]
      },
      "SseEventData": {
        "type": "object",
        "additionalProperties": false,
        "description": "SSE data 본문. 원문 전체와 비밀값은 넣지 않는다.",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "run_id",
          "revision",
          "message"
        ]
      },
      "SseEvent": {
        "type": "object",
        "additionalProperties": false,
        "description": "SSE 한 건의 논리 구조. 전송 형식은 id/event/data 줄이며 id는 run 안에서 단조 증가한다.",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "event": {
            "type": "string",
            "enum": [
              "status",
              "interrupt",
              "artifact",
              "error",
              "completed",
              "cancelled"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/SseEventData"
          }
        },
        "required": [
          "id",
          "event",
          "data"
        ]
      },
      "BaselineInput": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "revision"
        ],
        "title": "BaselineInput"
      },
      "Body_createRun": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "pack": {
            "type": "string",
            "title": "Pack"
          }
        },
        "type": "object",
        "required": [
          "file",
          "pack"
        ],
        "title": "Body_createRun"
      },
      "CancelRequest": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "title": "CancelRequest"
      },
      "ExcludedBlock": {
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1,
            "title": "Block Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "block_id"
        ],
        "title": "ExcludedBlock",
        "description": "추출 확인에서 뺄 원문 블록. 사유는 `review` 블록이면 필수, `fail` 블록이면 선택이다.\n\n다음 답은 resume API가 422 `INVALID_RESPONSE`로 막는다: 없는 블록, `pass` 블록,\n`review` 블록의 빈 사유(공백만 있는 사유 포함), 같은 블록 두 번 (06 문서, #120).\n`fail` 블록의 빈 사유(`\"\"`)는 사유 없음으로 블록에 남긴다 (`SourceRequirement.excluded_reason`)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "InterruptKind": {
        "type": "string",
        "enum": [
          "extraction",
          "requirements",
          "review"
        ],
        "title": "InterruptKind",
        "description": "사람 확인(HITL) 지점. 값은 resume 응답의 `kind`와 같다 (05 문서 「모델별 `kind` 뜻」).\n\n- extraction: 추출 확인(UI-02). `review`·`fail` 블록이 있을 때만 멈춘다 (ADR-0015)\n- requirements: 분석 확인(HITL 1, UI-03). 품질 경고·질문·분할이 있을 때만 멈춘다 (ADR-0015)\n- review: 최종 검토(HITL 2, UI-06). 내보내기 전에 항상 멈춘다"
      },
      "ProjectInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProjectInput"
      },
      "RequirementAnswer": {
        "properties": {
          "req_id": {
            "type": "string",
            "minLength": 1,
            "title": "Req Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "keep",
              "edit",
              "split"
            ],
            "title": "Action"
          },
          "texts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Texts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "req_id",
          "action",
          "texts"
        ],
        "title": "RequirementAnswer",
        "description": "분석 확인(HITL 1)에서 요구사항 하나에 대한 답 (06 문서 resume).\n\n- keep: 그대로 둔다. `texts`는 비운다\n- edit: `texts` 1개로 문장(`text`)을 바꾼다. A01이 낸 `draft_text`는 남는다\n- split: `texts` 2개 이상으로 나눈다. 첫 조각은 원래 ID, 나머지는 서버가 새 ID를 붙이고\n  원문 연결·분류는 원래 요구사항과 같다"
      },
      "RunState": {
        "type": "string",
        "enum": [
          "queued",
          "parsing",
          "awaiting_input",
          "analysing",
          "awaiting_requirements",
          "designing",
          "generating",
          "reviewing",
          "awaiting_review",
          "exporting",
          "completed",
          "failed",
          "cancel_requested",
          "cancelled"
        ],
        "title": "RunState",
        "description": "run 상태. 값은 `docs/api/openapi.json`의 RunStatus.status와 같다."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "RunSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "specton_session",
        "description": "서버가 발급하는 세션 쿠키. 값이 owner_ref이며 만료는 없다(시연용). 모든 run 접근은 서버 owner 검사 (ADR-0011)."
      }
    }
  }
}
