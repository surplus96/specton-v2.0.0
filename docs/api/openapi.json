{
  "openapi": "3.1.1",
  "info": {
    "title": "Specton 실행 제어 API",
    "version": "0.1.0",
    "description": "실행 제어 API 계약 (ADR-0009). 계약 변경은 영향 분석과 호환성 검증을 기록한다. 설명은 docs/06-api.md."
  },
  "security": [
    {
      "RunSession": []
    }
  ],
  "paths": {
    "/runs": {
      "post": {
        "operationId": "createRun",
        "summary": "요구사항 문서(Excel·CSV·HWPX) 업로드·실행 등록",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "허용 확장자: .xlsx, .csv, .hwpx, .hwp (한글은 요구사항 상세표를 읽음, PDF는 이번 범위 밖)"
                  },
                  "pack": {
                    "type": "string",
                    "enum": [
                      "inventory",
                      "maintenance"
                    ]
                  }
                },
                "required": [
                  "file",
                  "pack"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "등록됨; 실행 성공을 의미하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "413": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listRuns",
        "summary": "소유자의 실행 목록 조회",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "parsing",
                "awaiting_input",
                "analysing",
                "awaiting_requirements",
                "designing",
                "generating",
                "reviewing",
                "awaiting_review",
                "exporting",
                "completed",
                "failed",
                "cancel_requested",
                "cancelled"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "실행 요약 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RunSummary"
                  }
                }
              }
            }
          },
          "422": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getRun",
        "summary": "현재 실행·대기·오류 상태 조회",
        "responses": {
          "200": {
            "description": "현재 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "404": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/events": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "streamRunEvents",
        "summary": "SSE 진행/interrupt/완료 이벤트",
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "id/event/data SSE. 각 이벤트의 논리 구조는 SseEvent 스키마, 종류·payload는 docs/06-api.md 참고",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/view": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getRunView",
        "summary": "화면 표시용 실행 내용 조회",
        "description": "Interrupt는 확인 대상만 알리며 추출 블록·요구사항·설계 모델·지적은 이 조회로 가져온다. 항목 구조는 docs/06-api.md \"화면용 조회\"를 따른다.",
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "extraction",
                "requirements",
                "design",
                "review"
              ]
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "요청 revision(생략 시 현재)의 화면 내용",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunView"
                }
              }
            }
          },
          "404": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/resume": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "resumeRun",
        "summary": "현재 revision의 사용자 답변 적용",
        "requestBody": {
          "required": true,
