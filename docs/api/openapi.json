            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "답변 접수·재개 또는 보류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "cancelRun",
        "summary": "실행 취소 요청",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "expected_revision"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "취소 요청됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatus"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/artifacts/{kind}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "kind",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "requirements",
              "functions",
              "erd",
              "ddl",
              "rtm",
              "review",
              "manifest"
            ]
          }
        }
      ],
      "get": {
        "operationId": "downloadArtifact",
        "summary": "같은 revision의 문서 다운로드",
        "description": "kind-file_format 허용 조합은 docs/06-api.md를 따른다. 미허용 조합 422, 미생성 409(PDF는 승인한 revision만). 초안은 파일명에 -draft. manifest JSON의 generator_versions.common_version·policy_digest는 정리 때 기록한 공통 팩 버전·정책 해시이며 기존 실행에는 null일 수 있다. 다운로드 때 현재 값으로 소급하지 않는다.",
        "parameters": [
          {
            "name": "file_format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "md",
                "pdf",
                "mmd",
                "sql",
                "xlsx",
                "csv",
                "json"
              ]
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "지정 형식 파일; Content-Disposition 제공",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "code/message/retryable 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
